# Runtime/application settings
IPSP_ENVIRONMENT=development
IPSP_APP_NAME=IPSP
IPSP_APP_VERSION=0.1.0
IPSP_DEBUG=false
IPSP_HOST=127.0.0.1
IPSP_PORT=8000
IPSP_LOG_LEVEL=INFO
IPSP_DATA_DIR=./data
IPSP_ARTIFACTS_DIR=./artifacts
IPSP_LOG_DIR=./logs
IPSP_FRONTEND_DIR=./frontend
IPSP_DEFAULT_THEME=system

# Local SQLite control plane; remote database URLs and embedded credentials are rejected.
IPSP_DATABASE__URL=sqlite:///./ipsp.db
IPSP_DATABASE__ECHO=false
IPSP_DATABASE__CONNECTION_TIMEOUT_SECONDS=5

# Platform feature availability; these are not authorization or outbound permission.
IPSP_FEATURES__LOCAL_LLM_ENABLED=false
IPSP_FEATURES__REMOTE_LLM_ENABLED=false
IPSP_FEATURES__SDV_ENABLED=false
IPSP_FEATURES__OPTIMIZATION_ENABLED=false
IPSP_FEATURES__CAUSAL_ENGINE_ENABLED=false
IPSP_FEATURES__EXPERIMENTAL_RAG_ENABLED=false

# Backend-enforced outbound policy. JSON array syntax is required for provider identifiers.
IPSP_OUTBOUND__INTERNET_ENABLED=false
IPSP_OUTBOUND__REMOTE_LLM_ENABLED=false
IPSP_OUTBOUND__ALLOWED_REMOTE_PROVIDERS=[]
IPSP_OUTBOUND__MODEL_DOWNLOAD_ENABLED=false
IPSP_OUTBOUND__UPDATE_CHECK_ENABLED=false
IPSP_OUTBOUND__DEFAULT_REMOTE_TRANSMISSION=remote_disabled

# Provider selection is non-secret metadata. Environment injection is the Phase 1B provider.
IPSP_SECRETS__PROVIDER=environment

# Never place real passwords, tokens, API keys, cookies, or other secret values in this file.
# Inject each secret separately at runtime and address it through an explicit SecretRef.
